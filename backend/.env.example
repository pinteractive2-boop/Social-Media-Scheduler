PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/social_media_scheduler
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api
# Production: set to your Vercel frontend URL (e.g. https://social-media-scheduler-phi.vercel.app)
FRONTEND_ORIGIN=

# IMPORTANT (production): The backend and frontend are on separate domains
# (Render <-> Vercel), so the session cookie must be sent cross-origin.
# Set NODE_ENV=production so the cookie is issued as SameSite=None; Secure.
# Without this, browsers withhold SameSite=Lax cookies on cross-origin fetch
# and every protected endpoint returns 401 Unauthorized.
NODE_ENV=production
